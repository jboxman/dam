#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$ROOT_DIR/.venv"
VENV_PYTHON="$VENV_DIR/bin/python"

find_python() {
  local candidate

  for candidate in \
    /opt/homebrew/bin/python3 \
    /opt/homebrew/bin/python3.13 \
    /opt/homebrew/bin/python3.12 \
    /opt/homebrew/bin/python3.11 \
    /opt/homebrew/bin/python3.10 \
    /opt/homebrew/bin/python3.9 \
    python3.13 \
    python3.12 \
    python3.11 \
    python3.10 \
    python3.9 \
    python3; do
    if command -v "$candidate" >/dev/null 2>&1; then
      "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' \
        && {
          printf '%s\n' "$candidate"
          return 0
        }
    fi
  done

  return 1
}

ensure_venv() {
  if [[ -x "$VENV_PYTHON" ]]; then
    "$VENV_PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' || {
      echo "Existing .venv uses Python < 3.9. Remove .venv, install Python 3.9+, then rerun ./dam." >&2
      exit 1
    }
    return 0
  fi

  local python_bin
  python_bin="$(find_python)" || {
    echo "Python 3.9+ is required. Install it, then rerun ./dam." >&2
    exit 1
  }

  "$python_bin" -m venv "$VENV_DIR"
}

ensure_dependencies() {
  "$VENV_PYTHON" -c 'import click' >/dev/null 2>&1 && return 0
  "$VENV_PYTHON" -m pip install click >/dev/null
}

ensure_venv
ensure_dependencies

export PYTHONPATH="$ROOT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$VENV_PYTHON" -m dam.cli "$@"
